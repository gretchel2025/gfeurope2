# Local app URL used for QR-code links during development
APP_BASE_URL=http://localhost:5173

# Current event id used to scope bookings, tickets, and counters
APP_EVENT_ID=gfeu2026

# Supabase Auth and app data. For local Supabase CLI defaults, use:
# PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local anon/publishable key from `supabase status`>
# SUPABASE_SERVICE_ROLE_KEY=<local service_role key from `supabase status`>
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Initial ticket counters for a brand-new local database
STANDARD_TICKETS_INITIAL_AVAILABLE=200
GRAND_FEAST_PLUS_TICKETS_INITIAL_AVAILABLE=50

# Optional if you want email sending to work locally
RESEND_API_KEY=
EMAIL_FROM=test@grandfeast.eu
EMAIL_REPLY_TO=test@grandfeast.eu

# Required for app startup because booking payment proofs must upload to Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional if you want local Supabase Google OAuth to work.
# Google Cloud OAuth must include this redirect URI:
# http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional offline-friendly local Supabase email/password auth.
# Used only by `make setup-local-auth` and the local-only sign-in form.
LOCAL_DEV_AUTH_EMAIL=admin@example.test
LOCAL_DEV_AUTH_PASSWORD=password
LOCAL_DEV_AUTH_ROLES=tester,admin,superuser
