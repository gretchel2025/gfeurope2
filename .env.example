MONGO_URI=mongodb://127.0.0.1:27017/grandfeast
MONGO_DB_CONNECT_TIMEOUT_MS=5000

# Local app URL used for QR-code links during development
APP_BASE_URL=http://localhost:5173

# Initial ticket counters for a brand-new local database
STANDARD_TICKETS_INITIAL_AVAILABLE=200
VIP_TICKETS_INITIAL_AVAILABLE=50
YOUTH_TICKETS_INITIAL_AVAILABLE=25

# Optional: comma-separated list of emails to seed into the local users collection
LOCAL_ADMIN_EMAILS=jonathangersam@gmail.com,gretchelglopez@gmail.com

# Optional for admin sign-in during local development
GOOGLE_ID=
GOOGLE_SECRET=
AUTH_SECRET=local-dev-auth-secret

# Optional if you want email sending and QR uploads to work locally
MY_POSTMARK_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
